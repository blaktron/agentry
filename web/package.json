{
  "name": "agentry-web",
  "private": true,
  "version": "0.1.0",
  "description": "Agentry web layer. M0: generated TS API client + smoke test. M5 (WG-I) turns this into the Next.js SSR app.",
  "type": "module",
  "scripts": {
    "gen": "openapi-typescript ../schemas/openapi.yaml -o lib/api/schema.d.ts",
    "check": "tsc --noEmit && vitest run",
    "smoke": "node scripts/smoke.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "openapi-fetch": "^0.13.0",
    "openapi-typescript": "^7.4.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
