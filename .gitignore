# binaries & build artifacts
/bin/
/dist/
/agentry
/agentryd

# local dev state
/.devdata/
*.log

# python bytecode: py_compile, or importing scripts/prose/gates.py to check a
# list by hand, writes it next to the source
__pycache__/

# node
node_modules/
web/.next/
web/out/

# editor/OS noise
.DS_Store
.idea/
.vscode/

# local config (the example ships as agentry.yaml.example)
/agentry.yaml

# test artifacts
coverage.out

# stray dev data written by tests run from package dirs
**/.devdata/

# compose interpolation values (deploy-local)
.env
dist/

# never commit a node_modules symlink: docker treats it as a file and the web image build fails
web/node_modules
