# Agentry web app image (§10, D-08 SSR). Non-root, production deps only.
#
# Build context is the repository root, not web/: the app generates its API
# client from schemas/openapi.yaml, so a web-only context could not produce a
# client that matches the server it ships alongside.
#
# NOTE for whoever owns web/ — this copies the full .next build plus a pruned
# node_modules and runs `next start`. Adding `output: "standalone"` to
# web/next.config.mjs would let the runner stage copy .next/standalone instead
# and drop node_modules entirely, roughly halving the image. That file is web
# source, so the one-line change belongs to that workgroup; this Dockerfile
# works either way and does not depend on it.

FROM node:24-bookworm-slim AS deps
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci

FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY web/ ./
# The generated client must match the spec this commit ships, not whatever was
# checked in: a stale schema.d.ts is a type-checked lie.
COPY schemas/ /schemas/
RUN npx openapi-typescript /schemas/openapi.yaml -o lib/api/schema.d.ts
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# Production dependency tree only — devDependencies (typescript, tailwind
# tooling, the openapi generator) have no business in a running image.
FROM node:24-bookworm-slim AS prod-deps
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci --omit=dev

FROM node:24-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# AGENTRY_API_BASE is read at request time (see web/next.config.mjs), never
# baked in, so one image runs in dev, staging and prod.
ENV PORT=3000

COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/next.config.mjs ./next.config.mjs
# Static assets (the brand SVGs the directory service references by URL).
COPY --from=build /app/public ./public

# uid 65532 matches the chart's podSecurityContext.runAsUser, so the web pods
# and the agentryd pods run as the same non-root identity.
RUN groupadd --gid 65532 nonroot \
 && useradd --uid 65532 --gid 65532 --home-dir /home/nonroot --create-home nonroot \
 && chown -R 65532:65532 /app
USER 65532:65532

EXPOSE 3000
CMD ["npx", "next", "start", "--port", "3000", "--hostname", "0.0.0.0"]
