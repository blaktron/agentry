# Agentry server configuration example (M0). Copy to agentry.yaml and adjust.
# Every key can be overridden by AGENTRY_* environment variables — see
# internal/config/config.go for the full mapping.

env: dev            # dev | staging | prod
devMode: true       # MUST be false in prod (config validation enforces)

http:
  addr: ":8080"
  # gitAddr: ":8081"   # optional separate listener for git smart-HTTP (§6.1)

database:
  url: postgres://agentry:agentry@localhost:5477/agentry_dev?sslmode=disable
  migrateOnStart: true

# redis:
#   url: redis://localhost:6379/0   # optional (D-06); absent = in-memory fallbacks

storage:
  kind: local        # local | s3
  localDir: .devdata/storage
  # s3Bucket: agentry-releases
  # s3Region: us-east-1

git:
  dataDir: .devdata/git

log:
  level: info        # debug | info | warn | error

auth:
  sessionTTL: 24h
  patMaxTTL: 8760h   # 1 year (§12.3)
  cookieSecure: false  # true outside local dev

signing:
  kind: none         # none (dev) | file | kms — prod requires file or kms

judge:
  provider: none     # none | static | openai | anthropic | bedrock | classifier (D-13)
  # openai/anthropic talk to any endpoint speaking that wire protocol
  # (hosted API or self-hosted gateway): set the API root and the key.
  # Env overrides: AGENTRY_JUDGE_TYPE (same as provider), AGENTRY_JUDGE_BASE_URL,
  # AGENTRY_JUDGE_API_KEY, AGENTRY_JUDGE_MODEL.
  baseUrl: ""        # e.g. https://api.openai.com or https://llm.gateway.internal
  apiKey: ""
  model: ""          # optional; defaults per protocol when empty
