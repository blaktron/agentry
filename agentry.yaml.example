# Agentry server configuration example. Copy to agentry.yaml and adjust.
# Every key can be overridden by AGENTRY_* environment variables — see
# internal/config/config.go for the full mapping.

env: dev            # dev | staging | prod
devMode: false      # opt-in, and only with env: dev; true switches off the sealing key, 2FA-on-publish, signing, the judge and the abuse signal at once

http:
  addr: ":8080"
  # gitAddr: ":8081"   # optional separate listener for git smart-HTTP

database:
  url: postgres://agentry:agentry@localhost:5477/agentry_dev?sslmode=disable
  migrateOnStart: true

# redis:
#   url: redis://localhost:6379/0   # optional; nothing in the core reads it today — the state replicas share is in Postgres

storage:
  kind: local        # local | s3
  localDir: .devdata/storage
  # s3Bucket: agentry-releases
  # s3Region: us-east-1

git:
  dataDir: .devdata/git
  # hooksDir: ""     # where the pre-receive hook runs from (must allow exec); empty = the system temp directory

log:
  level: info        # debug | info | warn | error

auth:
  sessionTTL: 24h
  patMaxTTL: 8760h   # 1 year
  trustedDeviceTTL: 720h  # 30 days, and 30 days is also the ceiling: how long
                          # a browser that answered the second factor may skip
                          # it. A second credential class — it never lengthens
                          # a session.
  cookieSecure: false  # true outside local dev
  # true hands credentials to an external sign-in provider — native
  # register/password/TOTP endpoints answer 410; configure auth.oidc (or the
  # older social.authentik).
  externalOnly: false
  # Sign in with your OpenID provider: any OIDC issuer. The redirect URI is
  # {baseURL}/api/v1/auth/oidc/<id>/callback. Leave id at oidc unless the
  # provider is the deployment's own directory, configured before as
  # social.authentik, whose accounts are linked as authentik (keep one of the
  # two configured, never both).
  oidc:
    id: oidc
    issuer: ""
    clientId: ""
    clientSecret: ""
    scopes: []       # empty asks for openid, email, profile
    displayName: ""  # the sign-in button's name; empty is "your OpenID provider"

# How this server presents itself and where browsers land.
web:
  url: ""              # a site that fronts this server (its origin); unset = the server's own /ui/ pages
ui:
  mode: full           # full | authorize | off — the server's own browser surface under /ui/
brand:
  name: ""             # what emails, authenticator apps and /ui/ call this deployment (default: the public host)
  logoURL: ""
  cssURL: ""
  supportEmail: ""
  securityEmail: ""
  privacyURL: ""
  termsURL: ""

signing:
  kind: none         # none (dev) | file | kms — prod requires file or kms

judge:
  provider: none     # none | static | openai | anthropic | bedrock | typesafe | classifier
  # typesafe (TypeSafe AI's Jev, hosted only): apiKey required; model is a
  # pinned version id, default jev-1.13.0 — an alias such as jev-latest is
  # refused at startup; baseUrl defaults to https://api.typesafe.ai.
  # openai/anthropic talk to any endpoint speaking that wire protocol
  # (hosted API or self-hosted gateway): set the API root and the key.
  # Env overrides: AGENTRY_JUDGE_TYPE (same as provider), AGENTRY_JUDGE_BASE_URL,
  # AGENTRY_JUDGE_API_KEY, AGENTRY_JUDGE_MODEL.
  baseUrl: ""        # e.g. https://api.openai.com or https://llm.gateway.internal
  apiKey: ""
  model: ""          # optional; defaults per protocol when empty

# Social login for individual accounts. All five are optional; a
# provider without credentials is simply not offered. google and microsoft
# have built-in OIDC endpoints; openai and claude need an issuer override.
social:
  google:
    clientId: ""
    clientSecret: ""
  github:
    clientId: ""
    clientSecret: ""
  # The deployment's own directory service; issuer is the
  # Authentik application, e.g. https://auth.example/application/o/agentry/
  authentik:
    clientId: ""
    clientSecret: ""
    issuer: ""
  microsoft:
    clientId: ""
    clientSecret: ""
  openai:
    clientId: ""
    clientSecret: ""
    issuer: ""     # OIDC issuer serving the sign-in flow (required)
  claude:
    clientId: ""
    clientSecret: ""
    issuer: ""     # OIDC issuer serving the sign-in flow (required)
